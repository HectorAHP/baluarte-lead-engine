NODE_ENV=development
PORT=3000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL=
# Optional. Leave all three empty to use FakeCalendarProvider (dev/tests). Setting all three
# switches the server to GoogleCalendarProvider automatically. See docs/GOOGLE-CALENDAR-SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
ADVISOR_TIMEZONE=America/Mexico_City
MEETING_DURATION_MINUTES=30
BOOKING_MIN_NOTICE_HOURS=2
BOOKING_MAX_DAYS_AHEAD=14
WORKDAY_START=09:00
WORKDAY_END=19:00

# Optional. All four required together to switch from FakeMessagingProvider to the real
# WhatsApp Cloud API (analogous to the Google Calendar switch above). Missing any one keeps
# FakeMessagingProvider active -- the server always boots without these, and tests never
# depend on them. See docs/WHATSAPP-ARCHITECTURE.md.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0

# Phase 3C feature flag. Default false. Independent of QUALIFICATION_ENGINE_ENABLED -- with this
# false, WhatsApp behavior is unaffected regardless of the qualification flag's value. Only set
# to "true" once a controlled test is intended; requires restarting the process to take effect.
WHATSAPP_BOOKING_ENABLED=false

# Production hardening -- web lead capture (POST /api/leads). Comma-separated allowlist of origins
# @fastify/cors accepts. Optional: unset falls back to a sensible NODE_ENV-based default (prod ->
# https://baluartecapital.com.mx + www; anything else -> local dev origins). Set explicitly to
# override either default. See config.ts's corsAllowedOrigins.
CORS_ALLOWED_ORIGINS=
# POST /api/leads rate limit (per IP, in-memory -- single instance only, see app.ts). Optional,
# defaults shown are what config.ts falls back to when unset.
LEADS_RATE_LIMIT_MAX=20
LEADS_RATE_LIMIT_WINDOW_MS=60000

# Fase 7A -- appointment reminders / confirmation / post-meeting follow-up / no-show. All default
# false -- the entire feature surface stays inert until each is explicitly set to "true". See
# docs/PHASE4-DESIGN.md and the Fase 7A report.
APPOINTMENT_REMINDERS_ENABLED=false
POST_MEETING_FOLLOWUP_ENABLED=false
NO_SHOW_DETECTION_ENABLED=false
APPOINTMENT_CONFIRMATION_ENABLED=false

# Fase 7A -- Meta Message Template names (WhatsApp requires a pre-approved template for any
# business-initiated message outside the 24h customer-service window). Defaults match the exact
# names proposed for Héctor to submit to Meta Business Manager -- see the Fase 7A report for the
# full template texts and variables. Sending fails loudly (never silently) until Meta actually
# approves whichever name is configured here.
WHATSAPP_TEMPLATE_REMINDER_24H=recordatorio_24h
WHATSAPP_TEMPLATE_REMINDER_2H=recordatorio_2h
WHATSAPP_TEMPLATE_POST_MEETING=seguimiento_post_cita
WHATSAPP_TEMPLATE_NO_SHOW=no_show_nudge
WHATSAPP_TEMPLATE_LANGUAGE=es_MX

# Fase 7A -- static secrets for the new internal/admin endpoints. Both optional; either endpoint
# fails closed (401) while its secret is unset. Generate with e.g. `openssl rand -hex 32`.
REMINDER_RUNNER_SECRET=
ADMIN_API_TOKEN=

# Fase 7B -- lead integrity / anti-fake-lead. All default false -- the entire feature stays inert
# (no field computed or stored, no honeypot enforcement, no DNS lookup) until explicitly enabled.
# See docs/security/ and the Fase 7B report.
LEAD_INTEGRITY_ENABLED=false
EMAIL_DNS_VALIDATION_ENABLED=false
DISPOSABLE_EMAIL_CHECK_ENABLED=false
EMAIL_DISPOSABLE_DOMAINS_EXTRA=
HONEYPOT_ENABLED=false
# Reserved -- no code reads this yet (see the Fase 7B report's "not built" list).
STRICT_BOOKING_INTEGRITY_ENABLED=false
