NODE_ENV=development
PORT=3000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL=
# Optional. Leave all three empty to use FakeCalendarProvider (dev/tests). Setting all three
# switches the server to GoogleCalendarProvider automatically. See docs/GOOGLE-CALENDAR-SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
ADVISOR_TIMEZONE=America/Mexico_City
MEETING_DURATION_MINUTES=30
BOOKING_MIN_NOTICE_HOURS=2
BOOKING_MAX_DAYS_AHEAD=14
WORKDAY_START=09:00
WORKDAY_END=19:00

# Optional. All four required together to switch from FakeMessagingProvider to the real
# WhatsApp Cloud API (analogous to the Google Calendar switch above). Missing any one keeps
# FakeMessagingProvider active -- the server always boots without these, and tests never
# depend on them. See docs/WHATSAPP-ARCHITECTURE.md.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
